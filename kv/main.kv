#:kivy 2.1.0
<LoginPage>:
    orientation: 'horizontal'
    padding: dp(10)
    spacing: dp(10)
    size_hint: None, None
    size: dp(300), dp(650)
    pos_hint: {'center_x': 0.5, 'center_y': 0.5}

    BoxLayout:
        orientation: 'vertical'
        padding: dp(5)
        spacing: dp(5)
        size_hint_y: None
        height: dp(600)
        pos_hint: {'center_x': 0.5, 'center_y': 0.5}
        canvas.before:
            Color:
                rgba: 1, 0.984, 0.675, 1
            Rectangle:
                size: self.size
                pos: self.pos
        
        # Header        
        BoxLayout:
            orientation: 'horizontal'
            padding: dp(10)
            spacing: dp(5)
            size_hint_y: None
            height: dp(85)
            height: dp(100)
            canvas.before:
                Color:
                    rgba: 1, 0.984, 0.675, 1
                Rectangle:
                    size: self.size
                    pos: self.pos

            Image:
                source: 'assets/logo/Nagcarlan.png'
                allow_stretch: True
                keep_ratio: True
                size_hint_y: None
                height: dp(80)

            BoxLayout:
                orientation: 'vertical'
                spacing: dp(2)
                canvas.before:
                    Color:
                        rgba: 1, 0.984, 0.675, 1
                    Rectangle:
                        size: self.size
                        pos: self.pos

                Label:
                    text: "[color=000000ff][b]SIKLAB - MDRRMO[/b][/color]"
                    font_name: 'Medium'
                    markup: True
                    font_size: dp(12)
                    halign: 'center'
                    valign: 'middle'
                    text_size: self.size

                Label:
                    text: "[color=000000ff]Municipality of Nagcarlan, Laguna[/color]"
                    font_name: 'Medium'
                    markup: True
                    font_size: dp(10)
                    halign: 'center'
                    valign: 'middle'
                    text_size: self.size

            Image:
                source: 'assets/logo/mdrrmo.png'
                allow_stretch: True
                keep_ratio: True
                size_hint_y: None
                height: dp(80)
        
        # Body
        BoxLayout:
            orientation: 'vertical'
            padding: dp(10)
            spacing: dp(10)
            size_hint_y: None
            height: dp(490)
            height: dp(400)
            canvas.before:
                Color:
                    rgba: 1, 0.984, 0.675, 1
                RoundedRectangle:
                    size: self.size
                    pos: self.pos
                    radius: [dp(15)]

            Label:
                text: '[color=000000ff][b]LOG IN[/b][/color]'
                font_name: 'Montserrat'
                font_size: dp(20)
                markup: True
                halign: 'center'
                valign: 'bottom'
                size_hint_y: None
                height: dp(30)

            BoxLayout:
                orientation: 'vertical'
                padding: dp(10)
                spacing: dp(5)
                height: dp(240)
                size_hint: 1, None
                canvas.before:
                    Color:
                        rgba: 1, 0.957, 0.129, 1
                    RoundedRectangle:
                        size: self.size
                        pos: self.pos
                        radius: [dp(30)]

                Label:
                    text: "[color=000000ff]Phone Number[/color]"
                    font_name: 'Montserrat'
                    markup: True
                    size_hint: None, None
                    height: dp(30)
                    pos_hint: {'center_x': 0.3}

                TextInput:
                    multiline: False
                    size_hint: None, None
                    size: dp(215), dp(30)
                    pos_hint: {"center_x": 0.5}

                Label:
                    text: "[color=000000ff]Password[/color]"
                    font_name: 'Montserrat'
                    markup: True
                    size_hint: None, None
                    height: dp(30)
                    pos_hint: {'center_x': 0.2}

                TextInput:
                    password: True
                    multiline: False
                    size_hint: None, None
                    size: dp(215), dp(30)
                    pos_hint: {"center_x": 0.5}

                Button:
                    text: "Log In"
                    background_normal: ''  # Remove default background
                    background_down: ''
                    background_color: 0, 0, 0, 0  # Make the default button transparent
                    font_name: 'Montserrat'
                    font_size: dp(13)
                    size_hint: None, None
                    pos_hint: {'center_x': 0.5}
                    height: dp(30)
                    width: dp(100)
                    on_press: root.login()

                    canvas.before:
                        Color:
                            rgba: (0.1, 0.59, 0, 1)  # Green #199700
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [10]  # Rounded corners (adjust for more/less curve)

                Button:
                    text: "[color=000000ff]Forgot Password[/color]"
                    background_normal: ''  # Remove default background
                    background_down: ''
                    background_color: 1, 0.957, 0.129, 1
                    markup: True
                    font_name: 'Montserrat'
                    font_size: dp(10)
                    size_hint: None, None
                    size: dp(120), dp(15)
                    pos_hint: {"center_x": 0.5}
                    on_press: root.forgotpassword()

                Button:
                    text: "[color=000000ff]Didnt have an Account? Sign Up[/color]"
                    background_normal: ''  # Remove default background
                    background_down: ''
                    background_color: 1, 0.957, 0.129, 1
                    markup: True
                    font_name: 'Montserrat'
                    font_size: dp(10)
                    size_hint: None, None
                    size: dp(150), dp(15)
                    pos_hint: {"center_x": 0.5}
                    on_press: root.signup()

            BoxLayout:
                orientation: 'vertical'
                padding: dp(10)
                spacing: dp(10)
                size_hint_y: None
                height: dp(50)
        #Footer
        BoxLayout:
            orientation: 'vertical'
            padding: dp(10)
            spacing: dp(15)
            size_hint_y: None
            size: dp(150), dp(80)
            pos_hint: {'center_x': 0.5, 'center_y': 0.5}

            BoxLayout:
                orientation: 'horizontal'
                spacing: dp(10)
                size_hint: None, None
                size: dp(100), dp(15)
                pos_hint: {'center_x': 0.5, 'center_y': 0.5}

                Image:
                    source: 'assets/logo/contact.png'
                    allow_stretch: True
                    keep_ratio: True
                    size_hint: None, None
                    size: dp(15), dp(15)
                    halign: 'center'
                    valign: 'middle'

                Label:
                    id: hotline_contact
                    text: '[color=000000ff][b]09123456789[/b][/color]'
                    font_name: 'Regular'
                    font_size: dp(10)
                    markup: True
                    size_hint: None, None
                    size: dp(150), dp(15)
                    halign: 'left'
                    valign: 'middle'
                    text_size: self.size

            BoxLayout:
                orientation: 'horizontal'
                spacing: dp(10)
                size_hint: None, None
                size: dp(160), dp(15)
                pos_hint: {'center_x': 0.5}

                Image:
                    source: 'assets/logo/email.png'
                    allow_stretch: True
                    keep_ratio: True
                    size_hint: None, None
                    size: dp(15), dp(15)
                    halign: 'center'
                    valign: 'middle'

                Label:
                    id: hotline_email
                    text: '[color=000000ff][b]siklabmdrrmo@gmail.com[/b][/color]'
                    font_name: 'Regular'
                    font_size: dp(10)
                    markup: True
                    size_hint: None, None
                    size: dp(150), dp(15)
                    halign: 'left'
                    valign: 'middle'
                    text_size: self.size
