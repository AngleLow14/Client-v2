                        size_hint: None, None
                        height: dp(30)
                        pos_hint: {'center_x': 0.35}

                    Button:
                        text: "[color=000000ff][b]Upload an Image[/b][/color]"
                        size_hint: None, None
                        font_name: 'Regular'
                        font_size: dp(13)
                        size: dp(200), dp(40)
                        pos_hint: {"center_x": 0.5}
                        on_release:
                            root.open_camera()
                        background_normal: ''
                        background_down: ''
                        markup: True
                        canvas.before:
                            Color:
                                rgba: 1, 1, 1, 1
                            RoundedRectangle:
                                size: self.size
                                pos: self.pos
                                radius: [dp(20)]

                    Button:
                        text: "Submit"
                        background_normal: ''  # Remove default background
                        background_down: ''
                        background_color: 0, 0, 0, 0  # Make the default button transparent
                        font_name: 'Montserrat'
                        font_size: dp(13)
                        size_hint: None, None
                        pos_hint: {'center_x': 0.5}
                        height: dp(30)
                        width: dp(100)
                        on_press: root.submit()

                        canvas.before:
                            Color:
                                rgba: (0.1, 0.59, 0, 1)  # Green #199700
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [10]  # Rounded corners (adjust for more/less curve)

                    Button:
                        text: "[color=000000ff][b]Cancel[/b][/color]"
                        background_normal: ''  # Remove default background
                        background_down: ''
                        background_color: 0, 0, 0, 0  # Make the default button transparent
                        font_name: 'Montserrat'
                        font_size: dp(13)
                        size_hint: None, None
                        pos_hint: {'center_x': 0.5}
                        height: dp(30)
                        width: dp(100)
                        markup: True
                        on_press: root.cancel()

                        canvas.before:
                            Color:
                                rgba: (0.1, 0.59, 0, 1)  # Green #199700
                            Line:
                                width: 2  # Border thickness
                                rounded_rectangle: [self.x, self.y, self.width, self.height, 10]
