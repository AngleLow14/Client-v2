                    TextInput:
                        multiline: False
                        size_hint: None, None
                        size: dp(200), dp(30)
                        pos_hint: {"center_x": 0.5}

                    Label:
                        text: "[color=000000ff]Attach an Image:[/color]"
                        font_name: 'Regular'
